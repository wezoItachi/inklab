{
  "name": "inklab",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "author": "wezoItachi",
  "repository": {
    "type": "git",
    "url": "https://github.com/wezoItachi/inklab.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "data:import-weapons": "node scripts/import-leanny-weapons.mjs",
    "data:import-shooter-parameters": "node scripts/import-leanny-shooter-parameters.mjs",
    "data:import-blaster-parameters": "node scripts/import-leanny-blaster-parameters.mjs",
    "data:import-roller-parameters": "node scripts/import-leanny-roller-parameters.mjs",
    "data:import-charger-parameters": "node scripts/import-leanny-charger-parameters.mjs",
    "data:import-remaining-parameters": "node scripts/import-leanny-remaining-parameters.mjs",
    "data:import-salmon-parameters": "node scripts/import-leanny-salmon-parameters.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "oxlint",
    "format": "oxfmt",
    "check:public": "node scripts/check-public-readiness.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.1",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.21.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
