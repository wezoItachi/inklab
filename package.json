    "data:import-remaining-parameters": "node scripts/import-leanny-remaining-parameters.mjs",
    "data:import-salmon-parameters": "node scripts/import-leanny-salmon-parameters.mjs",
    "data:import-salmon-weapon-names": "node scripts/import-leanny-salmon-weapon-names.mjs",
    "data:import-salmon-ink-cycle": "node scripts/import-leanny-salmon-ink-cycle.mjs",
    "data:import-movement-classes": "node scripts/import-leanny-movement-classes.mjs",
